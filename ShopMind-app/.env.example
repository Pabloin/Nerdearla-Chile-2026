# .env.example — copy to .env and fill in your values

# AgentCore Gateway endpoint (from setup_gateway.py output)
AGENTCORE_GATEWAY_URL=https://xxxx.execute-api.us-east-1.amazonaws.com/mcp

# Cognito for Gateway auth
COGNITO_CLIENT_ID=your-cognito-client-id
COGNITO_DISCOVERY_URL=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_xxxxx/.well-known/openid-configuration
GATEWAY_ACCESS_TOKEN=your-jwt-token

# Lambda function names for tools (created manually or via CDK)
PRICE_LAMBDA=shopmind-price-scraper
REVIEWS_LAMBDA=shopmind-review-analyzer

# MCP server URLs (from `agentcore launch` output)
SEARCH_MCP_URL=https://xxxx.runtime.agentcore.us-east-1.amazonaws.com
PRICE_MCP_URL=https://yyyy.runtime.agentcore.us-east-1.amazonaws.com
REVIEWS_MCP_URL=https://zzzz.runtime.agentcore.us-east-1.amazonaws.com
MEMORY_MCP_URL=https://wwww.runtime.agentcore.us-east-1.amazonaws.com

# Frontend (Vite)
VITE_AGENT_URL=http://localhost:8000

# Mercado Libre API credentials
MERCADOLIBRE_CLIENT_ID=your-client-id
MERCADOLIBRE_CLIENT_SECRET=your-client-secret
MERCADOLIBRE_ACCESS_TOKEN=your-access-token
